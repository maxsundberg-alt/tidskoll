<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mall. Söndag 20:00. Sov datorn då körs den när den vaknar. -->
    <key>Label</key>
    <string>com.tidskoll.veckorapport</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__HOME__/tidskoll/bin/veckorapport.py</string>
        <string>--oppna</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>20</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/tidskoll/logg/veckorapport.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/tidskoll/logg/veckorapport.log</string>
</dict>
</plist>

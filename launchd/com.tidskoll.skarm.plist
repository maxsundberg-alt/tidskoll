<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mall. Startar Tidskoll.app, som i sin tur kör skärmdumpsloopen. -->
    <key>Label</key>
    <string>com.tidskoll.skarm</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/Applications/Tidskoll.app/Contents/MacOS/tidskoll</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/tidskoll/skarm/daemon.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/tidskoll/skarm/daemon.log</string>
</dict>
</plist>
